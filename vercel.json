{
  "version": 2,
  "routes": [
    { "src": "/api/login",      "dest": "/api/login.js" },
    { "src": "/api/get-data",   "dest": "/api/get-data.js" },
    { "src": "/api/test-token", "dest": "/api/test-token.js" },
    { "src": "/api/list-files", "dest": "/api/list-files.js" },
    { "src": "/api/config",     "dest": "/api/config.js" },
    { "src": "/api/crud",       "dest": "/api/crud.js" },
    { "src": "/",             "dest": "/public/index.html" },
    { "src": "/(.*)",         "dest": "/public/$1" }
  ]
}
